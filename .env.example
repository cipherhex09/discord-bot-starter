# Bot token from https://discord.com/developers/applications > your app > Bot
DISCORD_TOKEN=

# Comma separated server ids. Slash commands sync to these instantly.
# Leave empty in production to sync globally.
DEV_GUILD_IDS=

# Comma separated user ids allowed to run owner commands (@Bot sync, @Bot reload).
# Defaults to the application owner when empty.
OWNER_IDS=

# DATABASE_PATH=data/bot.db
# LOG_LEVEL=INFO
# LOG_DIR=logs          set empty to log to the console only
# SYNC_COMMANDS=true    set false to only sync with @Bot sync
